{
  "name": "Marketplace Dev",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "node",
  "workspaceFolder": "/workspace",
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/.postgres-data,target=/var/lib/postgresql/data,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/.claude-state/projects,target=/home/node/.claude/projects,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/.claude-state,target=/home/node/.claude,type=bind,consistency=cached"
  ],
  // 4100 = Dev-Server des Marktplatzes. Nicht 3000/3001 — die sind auf dem
  // Rechner des Betreibers durch eigene Server belegt (3000 = Firmenseite).
  // "onAutoForward: openBrowser" ist bewusst NICHT gesetzt, damit nicht bei
  // jedem Start ein Fenster aufspringt.
  "forwardPorts": [4100, 3000, 5432, 8081, 19000, 19001, 19002],
  "portsAttributes": {
    "4100": { "label": "Marktplatz (Dev)", "onAutoForward": "notify" },
    "5432": { "label": "PostgreSQL" }
  },
  "postCreateCommand": "sudo apk add --no-cache git openssh poppler-utils librsvg imagemagick && sudo npm install -g @anthropic-ai/claude-code expo-cli && bash /workspace/scripts/init-postgres.sh && bash /workspace/scripts/bootstrap-app.sh && bash /workspace/scripts/install-alias.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "Prisma.prisma",
        "bradlc.vscode-tailwindcss"
      ]
    }
  }
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  RESELLER
  OEM
  ENDKUNDE
  ADMIN
}

enum UserTrustTier {
  UNVERIFIED
  VERIFIED
  TRADE_ASSURED
  PREMIUM
  DIAMOND
}

// Bezahlte Abo-Stufe (Jahres-Zugang). null = keine aktive bezahlte Stufe.
//   BASIS  — Einstieg für Reseller (Angebots-Limit, Standard-Sichtbarkeit)
//   PRO    — aktive Händler (unbegrenzte Angebote, Vorrang, Analysen)
//   MARKE  — OEM/Hersteller (eigenes Marken-Schaufenster, gesponserte
//            Platzierung im KSS-Wizard)
enum MembershipTier {
  BASIS
  PRO
  MARKE
}

enum ListingStatus {
  ACTIVE
  PAUSED
  SOLD
  ARCHIVED
}

enum RfqStatus {
  OPEN
  ACCEPTED
  EXPIRED
  CANCELED
}

enum RfqVisibility {
  PUBLIC
  VERIFIED_ONLY
}

enum RfqOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum TransactionStatus {
  PENDING
  SHIPPED
  COMPLETED
  CANCELED
  DISPUTED
}

// Käuferschutz (Zahlungsfreigabe nach Lieferbestätigung) — bewusst NICHT
// "Treuhand"/"Escrow" genannt (Stripe Restricted-Businesses-Vorgabe; von
// Stripe-Support als zulässiger Ablauf bestätigt, Haltefrist max. 90 Tage).
// Geldfluss: Käufer zahlt über Stripe an die Plattform (separate charges &
// transfers), das Geld bleibt bei Stripe geparkt, erst nach Lieferbestätigung
// des Käufers wird an das Connect-Konto des Verkäufers überwiesen.
enum ProtectionStatus {
  NONE // ohne Käuferschutz (Direktabwicklung wie bisher)
  PENDING_PAYMENT // Käufer hat Checkout gestartet, Zahlung noch offen
  HELD // bezahlt — Geld bei Stripe geparkt bis Lieferbestätigung
  RELEASED // Käufer hat Lieferung bestätigt, Geld an Verkäufer überwiesen
  REFUNDED // Problemfall: Geld an Käufer zurückerstattet
  DISPUTED // Käufer hat Problem gemeldet — Superadmin entscheidet
}

enum ReviewTag {
  FAST_RESPONSE
  QUALITY_AS_DESCRIBED
  ON_TIME_DELIVERY
  FAIR_NEGOTIATION
}

enum ChemistryBase {
  MINERAL
  SYNTHETIC
  SEMI_SYNTHETIC
  ESTER
  PAG
  GTL // Gas-to-Liquid (Fischer-Tropsch, Gruppe III+ — sehr hoher VI, sehr rein)
  OTHER
}

enum ProductionType {
  CONTRACT_MANUFACTURING // Lohnfertigung — wechselnde Werkstoffe/Aufträge
  SERIAL_PRODUCTION // Serienproduktion — konstantes Werkstück/Verfahren
  MIXED // Mischbetrieb
}

enum CoolantConcentrateForm {
  CONVENTIONAL_EMULSION // klassische milchige Emulsion (Mineralöl + Tenside)
  SEMI_SYNTHETIC // halbsynthetisch (milchig-opal)
  FULL_SYNTHETIC // vollsynthetisch (klar, ohne Mineralöl)
  TWO_COMPONENT // Zweikomponenten-System
}

enum PackagingForm {
  DRUM
  IBC
  TANK
  CANISTER
  BULK
  OTHER
}

enum SdsCategory {
  WATER_MISCIBLE_COOLANT
  NEAT_CUTTING_OIL
  GRINDING_OIL
  HYDRAULIC_OIL
  GEAR_OIL
  MOTOR_OIL
  GREASE
  OTHER
}

enum SdsLanguage {
  DE
  EN
  FR
  IT
  OTHER
}

// Produktarten. Reihenfolge/Beschriftung zentral in lib/product-categories.ts,
// Stichwort-Erkennung in lib/product-category-detect.ts. Erweiterung 2026-08-02:
// zehn eigenständige Arten, die vorher unter SPECIALTY/OTHER verschwanden.
enum ProductCategory {
  COOLANT_WATER_MIX // wassermischbarer KSS-Konzentrat
  COOLANT_NEAT // nicht wassermischbares Schneidöl
  GRINDING_OIL // Schleiföl
  HONING_LAPPING_OIL // Hon-, Läpp-, Superfinishöl (eigener Markt, oft sehr niedrigviskos)
  MQL_FLUID // Minimalmengenschmierstoff (MMS/MQL) — verdampfungsarme Ester
  EDM_FLUID // Erodieröl (Senk/Draht), Dielektrikum
  HYDRAULIC_OIL
  FIRE_RESISTANT_HYDRAULIC // Schwer entflammbar (ISO 12922: HFA/HFB/HFC/HFDU/HFDR)
  GEAR_OIL
  CIRCULATION_OIL // Umlauf-/Lageröl (DIN 51517 C/CL/CLP), Papiermaschinenöl
  OPEN_GEAR_LUBRICANT // Haftschmierstoff für offene Getriebe (DIN 51502 "OG")
  COMPRESSOR_OIL
  SLIDEWAY_OIL // Bettbahnöl
  SPINDLE_OIL // Spindelöl (ISO VG 2–10, Hochfrequenzspindeln)
  TURBINE_OIL // Turbinenöl (DIN 51515 TD/TG)
  CHAIN_OIL // Ketten-/Hochtemperatur-Kettenöl
  REFRIGERATION_OIL // Kältemaschinenöl (POE/PAG/Mineral)
  VACUUM_PUMP_OIL // Vakuumpumpenöl
  FORMING_OIL // Stanz-/Umform-/Tiefziehöl
  FORGING_LUBRICANT // Gesenkschmierstoff Warmumformung (Graphit-Wasser/-Öl, graphitfrei)
  WIRE_DRAWING // Drahtzieh-Schmierstoff (Ziehseife, Ziehfett, Nassziehmittel)
  RELEASE_AGENT // Trennmittel (Druckguss, Gummi, Kunststoff), Schalungsöl
  MASS_FINISHING_COMPOUND // Gleitschleifmittel / Compound (Trowalisieren, Vibrationsschleifen)
  HEAT_TRANSFER_OIL // Wärmeträgeröl / Thermalöl (DIN 51522)
  QUENCHING_OIL // Härteöl / Abschrecköl (Wärmebehandlung)
  POLYMER_QUENCHANT // Wasserverdünnbares Polymer-Abschreckmittel (nicht mit Härteöl mischbar)
  TRANSFORMER_OIL // Isolieröl / Transformatorenöl (IEC 60296)
  CLEANER // Reiniger / Entfetter
  CORROSION_PROTECTION
  GREASE
  LUBRICATING_PASTE // Montage-/Schmierpaste mit hohem Festschmierstoffanteil
  DRY_FILM_LUBRICANT // Gleitlack / Trockenschmierstoff (MoS2, PTFE, Graphit)
  SPECIALTY // Spezial-/Sonderschmierstoff
  ADDITIVE
  OTHER
}

enum MaterialCompatibility {
  RECOMMENDED // explizit für diesen Werkstoff empfohlen
  COMPATIBLE // unproblematisch
  CAUTION // mit Einschränkungen / Bedingungen
  UNSUITABLE // nicht geeignet, dokumentierte Probleme
}

enum BusinessFocus {
  COOLANT // Kühlschmierstoffe (wassermischbar)
  NEAT_OIL // Nicht wassermischbare Schneidöle
  LUBRICANT // Schmierstoffe allgemein (Hydraulik, Getriebe, Motor)
  GREASE // Schmierfette
  CLEANER // Reiniger / Entfetter
  CORROSION_PROTECTION // Korrosionsschutz
  CHEMICAL_SUPPLIER // Chemie-Distributor / Mineralöl-Handel
  ADDITIVE // Additiv-Hersteller
}

model Manufacturer {
  id   String @id @default(cuid())
  name String @unique // Display name, z.B. "Blaser Swisslube"
  slug String @unique // url-safe, z.B. "blaser-swisslube"

  logoPath String? // /brand-logos/BlaserSwisslubeLogo.png
  website  String? // https://www.blaser.com

  headquartersCountry String? // ISO-3166-1 alpha-2 oder Klartext
  headquartersCity    String?
  foundedYear         Int?

  businessFocus   BusinessFocus[] @default([])
  productFamilies String[]        @default([]) // z.B. ["Blasocut", "Vasco", "Synergy"]
  description     String?

  // Wissens-Metadaten — was wir aus dem Web/Datenblättern wissen
  knownForApplications String[] @default([]) // z.B. ["Schleifen", "Drehen Alu", "Tiefbohren"]
  notes                String? // freitext, manuell pflegbar

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings  Listing[]
  sds       SafetyDataSheet[]
  products  Product[]
  // Konten, die diese Marke offiziell vertreten (Marke-Stufe, Schaufenster).
  brandReps User[]            @relation("BrandRep")
  adBanners AdBanner[]

  @@index([slug])
}

model Product {
  id             String       @id @default(cuid())
  manufacturerId String
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)

  name          String // Vollständiger Name z.B. "Blasocut 2000 CF"
  slug          String // url-safe, eindeutig pro Hersteller
  productFamily String? // z.B. "Blasocut"
  category      ProductCategory
  chemistry     ChemistryBase?

  description String?

  // Anwendung
  applicationAreas    String[] @default([]) // Drehen, Fräsen, Schleifen, Stanzen, ...
  suitableMaterials   String[] @default([]) // Stahl, Alu, Buntmetall, Guss, Titan, Hartmetall
  unsuitableMaterials String[] @default([]) // Werkstoffe wo Probleme dokumentiert sind

  // Eignung für Produktionsart (Lohnfertigung vs Serie)
  productionType ProductionType?

  // Form bei wassermischbaren KSS — entscheidend für Auswahl (milchig vs klar)
  concentrateForm CoolantConcentrateForm?

  // Praxis-Probleme die mit diesem Produkt explizit adressiert (oder bekannt) sind
  // Werte: "Fleckenbildung Buntmetall", "Schaum", "Geruch", "Hautirritation",
  //   "harzartige Ablagerungen", "kurze Standzeit", "schlechte Filtrierbarkeit",
  //   "Alu-Verfärbung", "Spritzwasserbeständigkeit", "Kompatibilität mit anderen
  //   Hochdruck-MMS", "Werkzeugstandzeit", "Tramp-Oil-Aufnahme"
  criticalIssuesAddressed String[] @default([])
  criticalIssuesKnown     String[] @default([]) // dokumentierte Schwachpunkte

  // Refraktometer — Schlüsselwert für KSS-Konzentratbestimmung
  refractometerFactor Float? // Brix × Faktor = % Konzentration

  // Empfohlene Konzentration im Gebrauchsbereich (wassermischbare KSS)
  recommendedConcentrationMin Float? // % v/v
  recommendedConcentrationMax Float? // % v/v

  // Typische Emulsions-Standzeit im Tank (Wochen) — Herstellerangabe/Praxiswert,
  // fließt in die Gesamtkostenrechnung (Wechsel = Stillstand + Entsorgung)
  typicalSumpLifeWeeks Int?

  // pH
  phConcentrate Float?
  phEmulsionMin Float? // bei Soll-Konzentration
  phEmulsionMax Float?

  // Physik
  densityGcm3    Float? // bei 20 °C
  flashpointC    Int? // °C (nur für Öle)
  viscosityIso   String? // ISO VG (für Öle)
  viscosityKv40  Float? // mm²/s bei 40 °C
  viscosityKv100 Float? // mm²/s bei 100 °C

  // Ansetzwasser-Anforderungen (wassermischbare KSS)
  waterHardnessMinDh Int? // °dH min empfohlen
  waterHardnessMaxDh Int? // °dH max empfohlen
  waterHardnessNotes String? // z.B. "demineralisiertes Wasser ungeeignet"

  // Lebensmittel-/Norm-Freigaben
  certifications String[] @default([]) // FDA H1, DIN 51385, TRGS 611, OEM-Freigaben

  // Markierungen
  containsBor               Boolean?
  containsFormaldehydeDepot Boolean?
  containsMineralOil        Boolean?
  containsChlorine          Boolean?
  mineralOilContentPct      Float? // 0-100 %

  // Quellen
  sourceUrl        String? // Produktseite Hersteller
  dataSheetUrl     String? // technisches Datenblatt (PDS)
  sdsUrl           String? // Sicherheitsdatenblatt
  sourceConfidence String? // "verifiziert", "modelliert", "geschätzt"

  notes String?

  // Verlinktes SDS aus der eigenen SDS-Bibliothek (sofern Match per Hersteller+Name möglich war)
  safetyDataSheetId String?
  safetyDataSheet   SafetyDataSheet? @relation(fields: [safetyDataSheetId], references: [id], onDelete: SetNull)

  // Normalisierter Suchindex: name + manufacturer + productFamily, lowercase,
  // ohne Trennzeichen — erlaubt "bcool755" → "B-Cool 755", "hocut795mp" → "Hocut 795 MP".
  searchTokens String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  compatibilityNotes MaterialCompatibilityNote[]
  priceObservations  PriceObservation[]
  issues             ProductIssue[]
  experienceReports  ExperienceReport[]
  photoHandoffs      PhotoHandoff[]
  productSubmissions ProductSubmission[]
  problemCases       ProblemCase[]
  coolantTanks       CoolantTank[]

  @@unique([manufacturerId, slug])
  @@index([manufacturerId])
  @@index([category])
  @@index([productFamily])
  @@index([safetyDataSheetId])
  @@index([searchTokens])
}

model ComparisonAnalysis {
  id        String   @id @default(cuid())
  // sha256 über die sortierte Liste der verglichenen IDs (Listings oder Products)
  cacheKey  String   @unique
  scope     String // "listings" oder "products"
  ids       String[] // die verglichenen IDs (sortiert wie cacheKey berechnet)
  // Strukturiertes Ergebnis als JSON: { perItem: [...], recommendation: "...", model: "..." }
  result    Json
  source    String // "anthropic-claude" | "heuristic-fallback"
  createdAt DateTime @default(now())

  @@index([scope, createdAt])
}

model MaterialCompatibilityNote {
  id        String   @id @default(cuid())
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Bei productId = null: allgemeine Regel (z.B. "Buntmetall + pH > 9.5 → Verfärbung")
  // Bei productId gesetzt: produkt-spezifischer Hinweis
  scope String // "product" oder "general"

  material      String // "Aluminium", "Buntmetall", "Magnesium", "Grauguss", "Titan", "Stahl", "Edelstahl"
  compatibility MaterialCompatibility

  condition String? // z.B. "pH > 9.5", "Konzentration > 8%", "demineralisiertes Wasser"
  note      String // Erklärung was passiert / worauf zu achten

  sourceUrl   String? // Hersteller-Doku, Fachartikel, FAQ
  sourceLabel String? // z.B. "Blaser FAQ", "VSI-Merkblatt"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([material])
}

// ============================================================
// Material-/Inhaltsstoff-Verträglichkeit (Dichtungen, Kunststoffe)
// ============================================================

enum MaterialCategory {
  ELASTOMER // NBR, EPDM, FKM, Silikon, HNBR, FFKM, PUR, ...
  THERMOPLASTIC // PA, POM, PP, PE, PVC, PTFE, PEEK
  THERMOSET // Epoxidharz, Phenolharz
  METAL // Stahl, Alu, Cu, Mg, ...
  COATING // Lacke, Beschichtungen
}

enum IngredientCategory {
  AMINE // Mono/Di/Triethanolamin, Morpholin, DEA
  BIOCIDE // Isothiazolinone, Bronopol, Triazin, Pyrithion, OIT
  FORMALDEHYDE_RELEASER // Bronopol, DMDM-Hydantoin, Triazin (Untergruppe Biozide)
  BASE_OIL_MINERAL // Mineralöl (Naphthenisch, Paraffinisch)
  BASE_OIL_ESTER // Ester-Basisöl
  BASE_OIL_PAO // Polyalphaolefin
  BASE_OIL_PAG // Polyalkylenglykol
  EMULSIFIER // Tenside (anionisch, nichtionisch)
  EP_ADDITIVE_S // Schwefel-EP
  EP_ADDITIVE_P // Phosphor-EP (ZDDP, ZnDTP)
  EP_ADDITIVE_CL // Chlorparaffine (SCCP, MCCP)
  CORROSION_INHIBITOR // Carboxylate, MBT, BTA, Aminborate
  BORATE // Borsäure, Borax, Perborate
  CHELATE // EDTA, NTA
  GLYCOL_ETHER // Butylglykol, Methoxypropanol
  SOLVENT_AROMATIC // Toluol, Xylol, Naphtha
  SOLVENT_POLAR // Ketone, Aceton, Alkohole
  WATER // Träger / Hauptphase wassermischbarer KSS
  ACID // Carbonsäuren, Borsäure, Phosphorsäure
  ALKALI // KOH, NaOH, Carbonate
  OTHER
}

enum EffectType {
  SWELLING // Volumen-/Längenzunahme
  SHRINKAGE // Schwund (Weichmacher-/Additiv-Extraktion)
  HARDENING // Verhärtung
  EMBRITTLEMENT // Versprödung, Rissbildung
  EXTRACTION // Auswaschen von Mischungsbestandteilen
  ATTACK_NETWORK // Angriff der Vernetzungsbrücken (irreversibel)
  NONE
}

model Material {
  id        String           @id @default(cuid())
  slug      String           @unique // "nbr", "epdm", "fkm-bisphenol"
  name      String // "NBR (Nitril-Butadien-Kautschuk)"
  shortName String // "NBR"
  category  MaterialCategory

  description     String?
  typicalUseCases String[] @default([]) // ["Hydraulik-O-Ringe", "Wellendichtringe"]
  temperatureMinC Int?
  temperatureMaxC Int?

  // Charakteristik nach Polarität (similia similibus solvuntur)
  isPolar Boolean?

  // Wenn Untertyp: Verweis auf "Eltern"-Familie (FKM-Bisphenol → FKM)
  parentSlug String?

  sourceUrl   String?
  sourceLabel String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  compatibilities IngredientMaterialCompatibility[]

  @@index([category])
  @@index([slug])
}

model Ingredient {
  id         String             @id @default(cuid())
  slug       String             @unique // "monoethanolamine", "boric-acid"
  name       String // "Monoethanolamin (MEA)"
  shortName  String? // "MEA"
  category   IngredientCategory
  casNumbers String[]           @default([])

  functionInFluid         String? // "pH-Stabilisierung & Korrosionsschutz für Eisen"
  typicalConcentrationPct Float? // typischer Anteil in KSS-Konzentrat in %
  isSvhc                  Boolean @default(false)
  description             String?

  sourceUrl   String?
  sourceLabel String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  compatibilities IngredientMaterialCompatibility[]

  @@index([category])
}

model IngredientMaterialCompatibility {
  id           String     @id @default(cuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  materialId   String
  material     Material   @relation(fields: [materialId], references: [id], onDelete: Cascade)

  rating      MaterialCompatibility // RECOMMENDED, COMPATIBLE, CAUTION, UNSUITABLE
  effectType  EffectType?
  swellPctMin Float? // erwartete Volumenquellung in %
  swellPctMax Float?

  conditionNote String? // "bei T > 60°C", "Langzeit > 1000h", "dynamisch"
  note          String // Erklärung des Mechanismus / praktische Wirkung

  sourceUrl   String?
  sourceLabel String? // "ISM Compatibility Chart", "Trelleborg DB"
  confidence  String? // "verifiziert", "indikativ", "geschätzt"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ingredientId, materialId])
  @@index([materialId])
  @@index([ingredientId])
  @@index([rating])
}

model User {
  id                   String          @id @default(cuid())
  email                String          @unique
  passwordHash         String
  pseudonym            String          @unique
  role                 UserRole        @default(RESELLER)
  trustTier            UserTrustTier   @default(UNVERIFIED)
  // INTERN / NUR SUPERADMIN — bezahlter Sichtbarkeits-Boost.
  // Höherer Wert ⇒ Angebote dieses Resellers erscheinen weiter oben in
  // Suchergebnissen und Vorschlägen. Wird NIE an die normale UI/API
  // ausgegeben und ist nur über /admin durch den Eigentümer steuerbar.
  searchBoost          Int             @default(0)
  // Bezahlte Jahres-/Zugangsmitgliedschaft (Stripe, echtes Abo mit
  // automatischer Verlängerung). Aktiv, solange membershipValidUntil in
  // der Zukunft liegt — dieses Feld wird bei jeder erfolgreichen
  // Verlängerungszahlung (Webhook invoice.payment_succeeded) fortgeschrieben.
  stripeCustomerId     String?
  // Stripe-Subscription-ID des aktiven Abos (null = kein/kein aktives Abo).
  stripeSubscriptionId String?
  membershipValidUntil DateTime?
  // Gebuchte Preisstufe (BASIS/PRO/MARKE). null = keine aktive bezahlte Stufe.
  // Steuert Funktions-Freischaltung (Angebots-Limit, Sichtbarkeit, Analysen,
  // Marken-Schaufenster). Wird beim Checkout gesetzt, bei Ablauf/Kündigung
  // bleibt der letzte Wert, ist aber ohne membershipValidUntil wirkungslos.
  membershipTier       MembershipTier?

  // Manuelle Sperre durch den Betreiber: gesperrte Konten können sich nicht
  // anmelden, laufende Sitzungen verlieren beim nächsten Aufruf den Zugriff,
  // API-Schlüssel werden abgewiesen. Der Grund ist nur im Admin sichtbar.
  blockedAt                   DateTime?
  blockedReason               String?
  // true = Nutzer hat gekündigt; Abo läuft zum Ende der bezahlten Periode
  // aus (membershipValidUntil) und verlängert sich NICHT automatisch weiter.
  membershipCancelAtPeriodEnd Boolean                  @default(false)
  payments                    Payment[]
  emailLogs                   EmailLog[]
  referralCodesCreated        ReferralCode[]           @relation("ReferralCodesCreatedBy")
  referralRedemptions         ReferralCodeRedemption[]
  // KYC light — internal only
  companyName                 String?
  vatId                       String?
  // USt-ID-Prüfung gegen VIES (offizielle EU-Datenbank, lib/vat-validation.ts):
  // Zeitpunkt der letzten ERFOLGREICHEN Prüfung + der von VIES gemeldete
  // Firmenname. null = nie erfolgreich geprüft.
  vatValidatedAt              DateTime?
  vatValidatedName            String?
  country                     String?
  // Gewünschte Anzeige-/Abrechnungswährung, vom Nutzer im Profil wählbar.
  // Nicht gesetzt (null) → wird aus `country` abgeleitet (lib/currency.ts).
  preferredCurrency           String?
  // Käuferschutz als Verkäufer anbieten: Stripe-Connect-Konto (Express).
  // onboarded = Stripe-Prüfung abgeschlossen (charges+payouts aktiv) →
  // Abzeichen "Käuferschutz verfügbar" auf Profil und Angeboten.
  stripeConnectAccountId      String?
  stripeConnectOnboarded      Boolean                  @default(false)
  // Öffentlicher Schaufenster-Text ("Über uns") auf der Profilseite —
  // pseudonym bleibt, aber der Anbieter kann sich fachlich vorstellen.
  about                       String?

  // ---- Marke-Stufe: Hersteller-Schaufenster ----
  // Welchen Hersteller/Marke dieses Konto offiziell vertritt. Nur mit aktiver
  // MARKE-Stufe wirksam: schaltet das öffentliche Marken-Schaufenster frei und
  // hebt die Produkte dieses Herstellers als "gesponsert" im KSS-Wizard hervor
  // (klar gekennzeichnet, P2B-VO-konform).
  brandManufacturerId String?
  brandManufacturer   Manufacturer? @relation("BrandRep", fields: [brandManufacturerId], references: [id], onDelete: SetNull)
  // Öffentliche Überschrift des Marken-Schaufensters (z.B. Claim/Slogan).
  storefrontHeadline  String?

  // ---- Monetarisierung: KI-Credits, Trial, Referral ----
  // KI-Funktionen (Alternativsuche, KSS-Wizard, Concierge) kosten Credits.
  // Guthaben wird zusätzlich als CreditTransaction-Historie geführt.
  creditBalance    Int       @default(0)
  // Kennenlernphase: bis zu diesem Datum ist die Plattform ohne Abo nutzbar.
  // Dauer stellt der Superadmin in /admin ein (AppSetting trialDays).
  trialEndsAt      DateTime?
  // Kontaktdaten-Filter: Zeitpunkt der einmaligen KI-Prüfung der ersten
  // Nachricht dieses Accounts (Kosten trägt Brisco, max 1× pro Account —
  // siehe lib/contact-filter.ts). null = noch nicht geprüft.
  aiContactCheckAt DateTime?
  // Referral: Wer hat diesen Nutzer geworben? (Empfehlungs-Code = Pseudonym)
  referredById     String?
  referredBy       User?     @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals        User[]    @relation("Referrals")

  creditTransactions CreditTransaction[]
  apiKeys            ApiKey[]
  experienceReports  ExperienceReport[]
  photoHandoffs      PhotoHandoff[]
  productSubmissions ProductSubmission[]
  problemCases       ProblemCase[]
  adBanners          AdBanner[]          @relation("AdOwner")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  listings        Listing[]
  buyerThreads    Conversation[]     @relation("BuyerThreads")
  sellerThreads   Conversation[]     @relation("SellerThreads")
  messages        Message[]
  rfqs            Rfq[]
  offers          RfqOffer[]
  buyerTxns       Transaction[]      @relation("BuyerTx")
  sellerTxns      Transaction[]      @relation("SellerTx")
  reviewsGiven    Review[]           @relation("ReviewsGiven")
  reviewsReceived Review[]           @relation("ReviewsReceived")
  submittedPrices PriceObservation[] @relation("SubmittedPrices")
  verifiedPrices  PriceObservation[] @relation("VerifiedPrices")

  submittedIssues ProductIssue[] @relation("ProductIssueSubmitted")
  verifiedIssues  ProductIssue[] @relation("ProductIssueVerified")

  passwordResetTokens PasswordResetToken[]
  coolantTanks        CoolantTank[]
  tankMeasurements    TankMeasurement[]
}

// ============================================================
// Zahlungen (Stripe) — aktuell: Jahres-/Zugangsgebühr (Mitgliedschaft).
// ============================================================
enum PaymentKind {
  MEMBERSHIP // Jahres-/Zugangsgebühr
  CREDITS // KI-Credits-Paket
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model Payment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind      PaymentKind   @default(MEMBERSHIP)
  status    PaymentStatus @default(PENDING)
  amountEur Float
  currency  String        @default("eur")

  // Stripe-Referenzen (Checkout-Session / PaymentIntent) — Erstabschluss.
  stripeSessionId       String? @unique
  stripePaymentIntentId String?
  // Stripe-Invoice-ID einer Abo-Verlängerungszahlung (Webhook
  // invoice.payment_succeeded) — für Idempotenz, da Verlängerungen keine
  // Checkout-Session haben. Erstabschluss-Zahlungen haben dieses Feld leer.
  // Bewusst kein DB-Unique-Constraint (vermeidet riskante Migration auf
  // bestehender Tabelle) — Idempotenz wird im Code per findFirst geprüft.
  stripeInvoiceId       String?

  // Abgedeckter Zeitraum (bei MEMBERSHIP: 1 Jahr ab Zahlung)
  periodStart DateTime?
  periodEnd   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([stripeInvoiceId])
}

// ============================================================
// System-E-Mails — Prototyp-Log statt echtem Versand (siehe lib/mailer.ts).
// Deckt insbesondere die Abo-Kommunikation ab: Erinnerung vor automatischer
// Verlängerung + Bestätigung danach (rechtlicher Hintergrund siehe
// lib/membership-emails.ts).
// ============================================================
enum EmailKind {
  MEMBERSHIP_RENEWAL_REMINDER // ~30 Tage vor automatischer Verlängerung
  MEMBERSHIP_RENEWED // Bestätigung nach erfolgter Verlängerung
  PASSWORD_RESET // Link zum Zurücksetzen des Passworts
  ADMIN_NEW_USER // Benachrichtigung an den Betreiber bei jeder Registrierung
  RFQ_EXPIRED // Anfrage ist wegen abgelaufener Frist ausgelaufen (2026-08-12)
}

model EmailLog {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      EmailKind
  to        String
  subject   String
  body      String
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([kind])
}

// ============================================================
// Nutzungs-Messung (Web-Analytics, selbst gehostet & datenschutzarm).
// Grundlage für Produktentscheidungen: Welche Seiten werden genutzt,
// wonach wird gesucht, welche Funktionen kommen an?
// Bewusst OHNE IP-Adresse, ohne Cookies, ohne Fingerprinting. userId ist
// optional (nur bei eingeloggten Nutzern) und hat bewusst keine DB-Relation
// — Löschung eines Users lässt die anonymen Zähler intakt.
// Auswertung: /admin (Abschnitt "Nutzung").
// ============================================================
model UsageEvent {
  id        String   @id @default(cuid())
  // Ereignis-Art: "pageview" | "search" | "ai_action" | künftige Arten
  kind      String
  // Seite (bei pageview), z.B. "/listings"
  path      String?
  // Zusatzinfo: Suchbegriff (search), Aktionsname (ai_action), ...
  meta      String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
  @@index([createdAt])
}

// ============================================================
// Empfehlungs-Ereignisse — jedes Mal, wenn die Plattform (Wizard, KI-Analyse,
// Alternativsuche) ein Produkt vorschlägt, ein Datensatz. Grundlage für die
// Admin-Statistik "welche Hersteller profitieren von unseren Empfehlungen"
// (Sponsoring-Akquise). Fire-and-forget geschrieben, darf nie werfen.
// ============================================================
model RecommendationEvent {
  id             String   @id @default(cuid())
  productId      String
  manufacturerId String?
  // Quelle: "kss_wizard" | "alt_search"
  feature        String
  // "anthropic-claude" | "heuristic-fallback" | "rule-based" | "claude-web"
  source         String?
  createdAt      DateTime @default(now())

  @@index([manufacturerId, createdAt])
  @@index([productId, createdAt])
  @@index([createdAt])
}

// ============================================================
// KI-Token-Verbrauch — echte Token-Zahlen aus den Anthropic-Antworten
// (für die Kosten-/Nutzungsübersicht im Admin-Bereich). Ein Datensatz je
// Claude-Aufruf; wird "fire-and-forget" geschrieben und darf nie werfen.
// ============================================================
model AiTokenUsage {
  id                  String   @id @default(cuid())
  // Funktion: "kss_wizard" | "concierge" | "comparison" | "contact_filter" | "alternatives" | "alt_search"
  feature             String
  // Modell-ID aus der Antwort (z.B. "claude-haiku-4-5-20251001")
  model               String
  inputTokens         Int      @default(0)
  outputTokens        Int      @default(0)
  cacheCreationTokens Int      @default(0)
  cacheReadTokens     Int      @default(0)
  userId              String?
  createdAt           DateTime @default(now())

  @@index([createdAt])
  @@index([feature, createdAt])
}

// ============================================================
// KI-Credits — Guthaben-Historie (Gutschriften + Verbrauch)
// ============================================================
enum CreditTxKind {
  WELCOME // Startguthaben bei Registrierung (Kennenlernphase)
  PURCHASE // Gekauftes Paket (Stripe)
  REFERRAL // Prämie fürs Werben eines Neukunden (Pseudonym-Link)
  CODE // Eingelöster Referral-/Gutschein-Code (Admin-generiert)
  USAGE // Verbrauch durch eine KI-Funktion (negativ)
  ADMIN_ADJUST // Manuelle Korrektur durch den Superadmin
  EXPERIENCE // Prämie für einen freigegebenen Praxis-Erfahrungsbericht
}

/**
 * API-Schlüssel für die REST-Schnittstelle (/api/v1/*).
 * Nur Konten mit aktiver MARKE-Stufe dürfen Schlüssel anlegen und nutzen —
 * die Stufe wird bei JEDEM Aufruf geprüft, nicht nur beim Anlegen. Gespeichert
 * wird nur der sha256-Hash; der Klartext wird genau einmal angezeigt.
 */
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String // vom Nutzer vergebener Zweck, z.B. "ERP-Anbindung"
  keyHash    String    @unique // sha256 des Klartext-Schlüssels
  prefix     String // erste 12 Zeichen zur Wiedererkennung in der Liste
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([userId])
}

/**
 * Praxis-Erfahrung eines Nutzers zu einem Produkt — per Text oder Diktat vom
 * Smartphone eingereicht. Belohnung: Credits nach Freigabe durch den Betreiber
 * (JEDE geprüfte Erfahrung wird gleich belohnt, positiv wie negativ — sonst
 * wäre die Belohnung unlauteres „Review-Gating").
 */
model ExperienceReport {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  // Freitext-Produktangabe, wenn das Produkt (noch) nicht im Katalog steht
  productFreetext String?
  text            String
  source          ExperienceSource @default(TEXT)

  /// Womit hat der Nutzer zu kämpfen — die Sprache, in der Abteilungsleiter
  /// suchen ("Fleckenbildung Buntmetall", "Geruch am Montag", "Schaum").
  /// Freie Schlagworte statt starrer Liste: Praxis erfindet ständig neue.
  problems String[]           @default([])
  /// Auf welcher Maschine — freiwillig, macht den Bericht wertvoller.
  machine  String?
  /// Wie es ausgegangen ist (gelöst / nicht gelöst / offen) — Berichte ohne
  /// Ausgang helfen niemandem weiter.
  outcome  ExperienceOutcome?

  /// Fotos, Videos und Laborberichte zum Bericht.
  media  ExperienceMedia[]
  status ExperienceStatus  @default(PENDING)

  /// Vor-Einschätzung der KI. Sie entscheidet NICHTS — sie sortiert vor.
  /// Bei UNCLEAR darf die KI ausdrücklich nicht raten; der Bericht geht
  /// unverändert an den Betreiber zur manuellen Prüfung.
  aiVerdict      ExperienceAiVerdict @default(NOT_CHECKED)
  /// Begründung der KI in einem Satz — Entscheidungshilfe für den Betreiber.
  aiNote         String?
  creditsAwarded Int                 @default(0)
  adminNote      String?
  createdAt      DateTime            @default(now())
  reviewedAt     DateTime?

  @@index([status, createdAt])
  @@index([productId, status])
  @@index([userId])
}

/// Anhang zu einem Erfahrungsbericht: Foto, Video oder Laborbericht.
///
/// Ein Foto vom Tank sagt mehr als drei Absätze — und ein Laborbericht ist der
/// härteste Beleg, den ein Betrieb hat. Laborberichte enthalten aber
/// Firmenname, Ansprechpartner und Maschinennummern; sie werden deshalb nur
/// nach ausdrücklicher Bestätigung der Anonymisierung angenommen und wie jeder
/// Bericht vor der Veröffentlichung geprüft.
model ExperienceMedia {
  id       String              @id @default(cuid())
  reportId String
  report   ExperienceReport    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  kind     ExperienceMediaKind

  /// Bild/PDF als data:-URI (wie bei den Angebotsfotos, Railway hat kein
  /// dauerhaftes Dateisystem) ODER die Adresse eines Videos.
  data         String
  caption      String?
  /// Nur bei Laborberichten: Der Nutzer hat bestätigt, dass keine Namen,
  /// Adressen oder Auftragsnummern mehr darin stehen.
  anonymisiert Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([reportId])
}

enum ExperienceMediaKind {
  PHOTO
  VIDEO_LINK
  LAB_REPORT
}

enum ExperienceOutcome {
  SOLVED // Problem gelöst
  IMPROVED // besser, aber nicht weg
  UNSOLVED // nicht gelöst
  ONGOING // läuft noch
}

enum ExperienceSource {
  TEXT
  VOICE
}

/// Ergebnis der KI-Plausibilitätsprüfung.
enum ExperienceAiVerdict {
  NOT_CHECKED // noch nicht geprüft (z. B. kein API-Schlüssel)
  PLAUSIBLE // fachlich stimmig
  UNCLEAR // nicht entscheidbar — Betreiber prüft
  IMPLAUSIBLE // widerspricht Fachwissen oder wirkt wie Werbung/Spam
}

enum ExperienceStatus {
  PENDING
  APPROVED
  REJECTED
}

model CreditTransaction {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int // positiv = Gutschrift, negativ = Verbrauch
  kind      CreditTxKind
  note      String? // z.B. "KI-Alternativsuche" oder "Paket M (200 Credits)"
  createdAt DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([kind])
}

// ============================================================
// Referral-/Gutschein-Codes — vom Superadmin generiert (nur eigene
// Konsole /admin), vom Nutzer im Konto eingelöst für Credits.
// ============================================================
model ReferralCode {
  id        String    @id @default(cuid())
  code      String    @unique // z.B. "WILLKOMMEN2026" — vom Admin frei wählbar
  credits   Int
  // Verlängert beim Einlösen zusätzlich die Kennenlernphase um N Tage
  // (z.B. GRUENDER30 = 90 Tage + 50 Credits). 0 = nur Credits.
  trialDays Int       @default(0)
  maxUses   Int       @default(1)
  usedCount Int       @default(0)
  active    Boolean   @default(true)
  expiresAt DateTime?
  note      String? // interner Vermerk, z.B. "Messe Hannover 2026"

  createdById String
  createdBy   User   @relation("ReferralCodesCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  redemptions ReferralCodeRedemption[]
  createdAt   DateTime                 @default(now())

  @@index([active])
}

model ReferralCodeRedemption {
  id         String       @id @default(cuid())
  codeId     String
  code       ReferralCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  credits    Int
  redeemedAt DateTime     @default(now())

  @@unique([codeId, userId]) // ein Code pro Nutzer nur einmal einlösbar
}

// ============================================================
// Globale Einstellungen — vom Superadmin in /admin steuerbar
// (z.B. welcomeCredits, trialDays, referralCredits, creditPriceRp,
// membershipPriceEur)
// ============================================================
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ============================================================
// Passwort-Reset — "Passwort vergessen"-Flow
// ============================================================
//
// State of the art: Der eigentliche Token wird dem Nutzer per Link
// zugestellt; in der DB liegt nur sein sha256-Hash. Tokens laufen nach
// kurzer Zeit ab und sind genau einmal verwendbar (usedAt).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ============================================================
// Preisbeobachtungen — historische Marktpreise
// ============================================================
//
// Quellen:
//   - USER_SUBMITTED:  User meldet beobachteten Preis → PENDING bis verifiziert
//   - TRANSACTION:     automatisch aus abgeschlossener Marketplace-Transaktion → direkt VERIFIED
//   - LIST_PRICE:      Hersteller-Listenpreis (selten verfügbar)
//   - DISTRIBUTOR_QUOTE: Distributor-Webshop-Preis
//   - SEED_INDICATIVE: initial-Seed-Beispieldaten (markiert!)
//
// Aggregation: lib/price-aggregation.ts berechnet monatlichen Median für Charts.

enum PriceSource {
  USER_SUBMITTED
  TRANSACTION
  LIST_PRICE
  DISTRIBUTOR_QUOTE
  AGGREGATED
  SEED_INDICATIVE
}

enum PriceStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PriceUnit {
  EUR_PER_L
  EUR_PER_KG
  EUR_PER_PIECE
  CHF_PER_L
  CHF_PER_KG
  USD_PER_L
  USD_PER_KG
}

model PriceObservation {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  observedAt   DateTime // Datum des Preises (kann historisch sein)
  pricePerUnit Float
  unit         PriceUnit @default(EUR_PER_L)

  // Mengenstaffel
  quantityMin   Float? // ab welcher Menge gilt der Preis
  quantityMax   Float?
  packagingForm PackagingForm? // DRUM, IBC, CANISTER ...

  regionCode String? // ISO-2 Country: DE, CH, AT, ...

  source PriceSource
  status PriceStatus @default(PENDING)

  // Submission
  submittedByUserId String?
  submittedByUser   User?    @relation("SubmittedPrices", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  submittedAt       DateTime @default(now())

  // Verifizierung
  verifiedByUserId String?
  verifiedByUser   User?     @relation("VerifiedPrices", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  verifiedAt       DateTime?
  rejectionReason  String?

  // Provenance
  sourceUrl   String?
  sourceLabel String?
  notes       String?

  // Wenn aus Transaction abgeleitet
  transactionId String? @unique

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([observedAt])
  @@index([status])
  @@index([source])
  @@index([productId, status, observedAt])
}

model Rfq {
  id         String        @id @default(cuid())
  buyerId    String
  buyer      User          @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  status     RfqStatus     @default(OPEN)
  visibility RfqVisibility @default(PUBLIC)

  productType     String
  /// Konkrete Typenbezeichnung, falls bekannt — z. B. „Blasocut BC 35" oder
  /// „Zubora 60 H". Ohne dieses Feld musste der Einkäufer seinen KSS-Typ in
  /// die Bemerkungen schreiben, wo ihn kein Filter findet (Betreiber 2026-08-10).
  productName     String?
  manufacturer    String?
  isoViscosity    String?
  chemistry       ChemistryBase?
  applicationArea String?

  quantity       Float
  quantityUnit   String @default("L")
  locationRegion String

  deadline     DateTime
  budgetMinEur Float?
  budgetMaxEur Float?
  notes        String?

  // Anforderungen / Pain Points
  requiredCertifications String[] @default([])
  avoidIssues            String[] @default([])
  workpieceMaterial      String?

  acceptedOfferId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offers      RfqOffer[]
  transaction Transaction?

  @@index([status])
  @@index([productType])
  @@index([locationRegion])
}

model RfqOffer {
  id       String @id @default(cuid())
  rfqId    String
  rfq      Rfq    @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  priceEur           Float
  quantity           Float
  quantityUnit       String  @default("L")
  deliveryDays       Int
  notes              String?
  alternativeProduct String?
  alternativeReason  String?

  status    RfqOfferStatus @default(PENDING)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([rfqId, sellerId])
  @@index([rfqId])
  @@index([sellerId])
}

model Conversation {
  id        String   @id @default(cuid())
  buyerId   String
  sellerId  String
  listingId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buyer    User      @relation("BuyerThreads", fields: [buyerId], references: [id], onDelete: Cascade)
  seller   User      @relation("SellerThreads", fields: [sellerId], references: [id], onDelete: Cascade)
  listing  Listing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  messages Message[]

  @@unique([buyerId, sellerId, listingId])
  @@index([buyerId])
  @@index([sellerId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Listing {
  id       String        @id @default(cuid())
  sellerId String
  seller   User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  status   ListingStatus @default(ACTIVE)

  // FDS 4.2 Datenmodell
  productType     String // Hydrauliköl, KSS-Emulsion, etc.
  manufacturer    String // Shell, Fuchs, Mobil, OEM-Eigenmarke — Freitext, deprecated zugunsten manufacturerId
  manufacturerId  String?
  manufacturerRef Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  productName     String // z.B. Tellus S2 M 46
  isoViscosity    String? // ISO VG 32, 46, 68, ...
  chemistry       ChemistryBase @default(MINERAL)
  applicationArea String // CNC, Schleifen, Hydraulik, ...

  quantity     Float // Verfügbare Menge
  quantityUnit String @default("L") // L, kg, drums, IBCs
  minOrderQty  Float?

  locationRegion String // Region/Land — keine Adresse
  packaging      PackagingForm @default(DRUM)

  productionDate DateTime?
  expiryDate     DateTime?

  certificates  String[] // OEM-Freigaben, ISO, DIN, TRGS 611
  priceEur      Float? // optional, "auf Anfrage" wenn null
  shippingTerms String? // Selbstabholung / Lieferung / verhandelbar

  description String?

  // Fertigungs-Eignung — Bearbeitungsverfahren
  machiningOperations String[] @default([])

  // Rezeptur-Info
  mineralOilContent Float? // 0-100 %
  containsGlycol    Boolean?

  // Automatisierungs-Eignung (1-5) und vom Hersteller empfohlene Messverfahren
  automationSuitability Int?
  measurementMethods    String[] @default([])

  sdsId String?
  sds   SafetyDataSheet? @relation(fields: [sdsId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations Conversation[]
  transactions  Transaction[]
  photos        ListingPhoto[]

  @@index([productType])
  @@index([manufacturer])
  @@index([manufacturerId])
  @@index([isoViscosity])
  @@index([status])
  @@index([sdsId])
}

/**
 * Foto zu einem Angebot — vom Anbieter selbst aufgenommen (Handy oder Kamera).
 * Warum die Bytes in der Datenbank liegen und nicht als Datei: Der Server auf
 * Railway hat kein dauerhaftes Dateisystem, hochgeladene Dateien wären nach dem
 * nächsten Deploy weg. Die Bilder werden schon im Browser des Anbieters auf
 * max. 1600 px verkleinert (~200 kB), dazu kommt eine kleine Vorschau für
 * Trefferlisten — damit bleibt der Platzbedarf überschaubar.
 */
model ListingPhoto {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  position Int    @default(0) // 0 = Titelbild
  mimeType String @default("image/jpeg")
  width    Int?
  height   Int?

  data      Bytes // Anzeigegröße (max. 1600 px Kante)
  thumb     Bytes? // Vorschau für Karten/Listen (max. 400 px)
  bytesSize Int     @default(0)
  sha256    String? // erkennt versehentliche Doppel-Uploads

  // Hinweis für Käufer: Wann wurde das Bild aufgenommen/hochgeladen?
  createdAt DateTime @default(now())

  @@index([listingId, position])
}

model Transaction {
  id        String  @id @default(cuid())
  buyerId   String
  sellerId  String
  rfqId     String? @unique
  listingId String?

  totalEur     Float
  quantity     Float
  quantityUnit String @default("L")

  // Einsparung durch Produktwechsel: Der Käufer kann erfassen, welches
  // Produkt er vorher eingesetzt hat und was es pro Einheit gekostet hat
  // (EUR). Einsparung = replacedPricePerUnit × quantity − totalEur.
  // Wird als Kennlinie in der Umsatzansicht (/umsaetze) angezeigt.
  replacedProductName  String?
  replacedPricePerUnit Float?

  // Käuferschutz (siehe enum ProtectionStatus). Die Abwicklungsgebühr trägt
  // der Käufer (transparent im Checkout); die Plattform verdient daran nichts.
  protectionStatus                ProtectionStatus @default(NONE)
  protectionFeeEur                Float?
  stripeProtectionSessionId       String?
  stripeProtectionPaymentIntentId String?
  stripeProtectionTransferId      String?

  status      TransactionStatus @default(PENDING)
  shippedAt   DateTime?
  completedAt DateTime?
  canceledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buyer   User     @relation("BuyerTx", fields: [buyerId], references: [id], onDelete: Cascade)
  seller  User     @relation("SellerTx", fields: [sellerId], references: [id], onDelete: Cascade)
  rfq     Rfq?     @relation(fields: [rfqId], references: [id], onDelete: SetNull)
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  reviews Review[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
}

model Review {
  id            String      @id @default(cuid())
  transactionId String
  reviewerId    String
  revieweeId    String
  rating        Int // 1–5
  comment       String?
  tags          ReviewTag[]
  createdAt     DateTime    @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  reviewer    User        @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee    User        @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@unique([transactionId, reviewerId])
  @@index([revieweeId])
}

model SafetyDataSheet {
  id              String        @id @default(cuid())
  manufacturer    String // Freitext, deprecated zugunsten manufacturerId
  manufacturerId  String?
  manufacturerRef Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  productName     String
  category        SdsCategory
  language        SdsLanguage   @default(DE)
  version         String?
  revisionDate    DateTime?

  sourceUrl     String
  filePath      String
  fileSizeBytes Int
  sha256        String @unique
  pageCount     Int?

  extractedText String?

  // Normalisierter Suchindex: productName + manufacturer + version, lowercase,
  // ohne Bindestriche/Spaces/Punkte/Schrägstriche. Erlaubt "bcool755" → "B-Cool 755".
  // Wird beim Seed (lib/normalize-search.ts) und Backfill gesetzt.
  searchTokens String?

  // -------------------------------------------------------------------------
  // Aus extractedText geparste strukturierte Felder (siehe lib/sds-parser.ts)
  // -------------------------------------------------------------------------
  // GHS / CLP
  hStatements   String[] @default([]) // z.B. "H226", "H315", "H319"
  pStatements   String[] @default([]) // z.B. "P210", "P280", "P305+P351+P338"
  ghsPictograms String[] @default([]) // z.B. "GHS02", "GHS07", "GHS09"
  signalWord    String? // "Gefahr" / "Achtung" / "Danger" / "Warning"

  // Physikochemische Kennzahlen (Section 9)
  physicalState   String? // "flüssig", "fest", "Aerosol"
  appearanceColor String? // "klar", "gelblich", "transparent"
  odor            String? // "öltypisch", "schwach", "geruchlos"
  phValue         Float? // pH (Konzentrat oder Emulsion)
  phContext       String? // "Konzentrat", "5% Emulsion"
  flashpointC     Float? // °C
  densityGcm3     Float? // g/cm³ bei 20°C
  viscosityKv40   Float? // mm²/s bei 40°C
  pourpointC      Float? // Stockpunkt °C
  boilingPointC   Float? // Siedepunkt °C
  waterSolubility String? // "löslich", "nicht löslich", "emulgierbar"

  // Inhaltsstoffe (Section 3)
  casNumbers String[] @default([]) // alle erkannten CAS-Nummern im Text

  // -------------------------------------------------------------------------
  // REACH + Inhaltsstoff-Flags (Parser-Heuristik, siehe lib/sds-ingredients.ts)
  // -------------------------------------------------------------------------
  // REACH-Konformität: null = unbekannt, true = registriert/konform, false = nicht
  reachCompliant Boolean?
  reachNotes     String? // Freitext, z.B. "Annex XVII", "SVHC: keine"
  svhcSubstances String[] @default([]) // erkannte SVHC-Stoffe (Name+CAS)

  // Inhaltsstoff-Klassen (true = enthalten laut SDS, false = ausdrücklich frei, null = unklar)
  containsBoron                 Boolean? // Borsäure, Borate, Borax (CAS 10043-35-3 u.a.)
  containsFormaldehydeReleaser  Boolean? // Bronopol, DMDM-Hydantoin, Triazin etc.
  containsSecondaryAmines       Boolean? // DEA, Morpholin, Diethylamin (Nitrosamin-Risiko)
  containsChlorinatedParaffins  Boolean? // SCCP, MCCP — REACH Anhang XVII
  containsMineralOil            Boolean? // Mineralöl als Hauptkomponente
  containsPrimaryAromaticAmines Boolean? // PAA — REACH-relevant

  // Wirkstoffe / Biozide
  hasBactericide  Boolean? // MIT, BIT, CMIT, OIT, Formaldehyd-Donatoren
  hasFungicide    Boolean? // IPBC, Pyrithion-Natrium etc.
  biocidalActives String[] @default([]) // konkrete Wirkstoffe als Strings

  // Entsorgung / Gewässerschutz (Section 12/13/15) — Einkäufer-Compliance
  wgkClass String? // Wassergefährdungsklasse: "nwg", "1", "2", "3"
  avvCode  String? // Abfallschlüssel nach AVV, z.B. "12 01 09*"

  // Transport (Section 14)
  adrClass       String? // "9", "3", "kein Gefahrgut"
  unNumber       String? // "UN 1993" etc.
  transportClass String? // verbatim Bezeichnung

  // Hersteller-/Lieferant-Info (Section 1)
  supplierName    String?
  supplierAddress String?
  emergencyPhone  String?

  // Parser-Metadaten
  parsedAt      DateTime?
  parsedVersion String? // welche Parser-Version lief

  fetchedAt DateTime @default(now())

  listings Listing[]
  products Product[]

  @@index([manufacturer])
  @@index([manufacturerId])
  @@index([category])
  @@index([productName])
  @@index([searchTokens])
}

// === Praxis-Probleme aus Foren, Hersteller-Hinweisen, Distributoren, Reviews ===
enum IssueCategory {
  BIOLOGY // Bakterien, Pilze, Verkeimung, Geruch
  FOAM // Schaumbildung
  CORROSION // Korrosion an Werkstücken, Maschinen, Tank
  TOOL_WEAR // Werkzeugverschleiß, kürzere Standzeiten
  OPERATOR_HEALTH // Hautirritation, Atemwege, Allergien, MAK
  SEAL_DAMAGE // Dichtungen, Schläuche, Lackangriff
  WORKPIECE_STAINS // Fleckenbildung Buntmetall, Alu-Anlauffarben, Niro
  RESIDUES // Klebrige Rückstände, Harzbildung, Maschinenverschmutzung
  FILTRATION // Filtrierbarkeit, Tramp-Oil-Aufnahme
  STABILITY // Emulsionsstabilität, Frostempfindlichkeit, Lagerung
  PERFORMANCE // Kühlleistung, Schmierleistung, Spülwirkung unzureichend
  COMPATIBILITY // Mischbarkeit mit anderem Öl/MMS/HD-Konzentrat
  REGULATORY // REACH, TRGS 611, Biozid-VO, Borfrei-Konflikte
  SHELF_LIFE // Kurze Lager-/Standzeit im Tank
  OTHER
}

enum IssueSeverity {
  LOW // Hinweis/kosmetisch
  MEDIUM // Beeinträchtigt Prozess, aber lösbar
  HIGH // Ausfall, Maschinenschaden, Gesundheitsrisiko
}

enum IssueSourceType {
  FORUM // industryarena, praktiker.com, cnczone, reddit r/Machinists, fachforum
  MANUFACTURER // Hersteller-FAQ, Anwendungstipps, Servicedokument
  DISTRIBUTOR // Distributor-Warnung, Anwendungshinweis
  CASE_STUDY // dokumentierte Fallstudie (Verein, Hochschule)
  REVIEW // User-Review (Amazon, Trustpilot)
  REGULATORY // BAuA, ECHA, TRGS-Updates
  SDS // direkt aus Sicherheitsdatenblatt entnommen
  USER_REPORT // direkt vom Plattform-User gemeldet
  OTHER
}

enum IssueStatus {
  PENDING // gemeldet, nicht verifiziert
  VERIFIED // von Admin/TRADE_ASSURED bestätigt
  RESOLVED // Hersteller hat in neuerer Formulierung behoben
  REJECTED // unzutreffend / nicht reproduzierbar
}

model ProductIssue {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  category IssueCategory
  severity IssueSeverity @default(MEDIUM)
  status   IssueStatus   @default(PENDING)

  title       String // Kurzbeschreibung, z.B. "Schaumbildung bei niedriger Konzentration"
  description String // Ausführlicher Bericht

  symptoms          String[] @default([]) // ["pH-Drop", "Geruch", "Fleckenbildung Messing"]
  rootCause         String? // wenn bekannt: "Bakterien (Pseudomonas) bei Stillstand"
  workaround        String? // Tipps zur Behebung
  preventiveMeasure String? // wie vermeiden

  // Kontext
  affectedMaterials     String[] @default([]) // Materialien wo Problem auftritt
  affectedOperations    String[] @default([]) // Anwendungen wo Problem auftritt
  reportedConcentration Float? // bei wassermischbaren KSS, %
  reportedPh            Float?
  reportedWaterHardness Int? // °dH

  sourceType   IssueSourceType
  sourceUrl    String? // URL des Forenposts / Doks
  sourceTitle  String? // Titel des Posts / Artikels
  sourceAuthor String? // wenn bekannt
  sourceDate   DateTime? // wann der Bericht erstellt wurde

  language SdsLanguage @default(DE)

  // Verifizierung
  submittedByUserId String?
  submittedByUser   User?     @relation("ProductIssueSubmitted", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  verifiedByUserId  String?
  verifiedByUser    User?     @relation("ProductIssueVerified", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  verifiedAt        DateTime?

  // Trust-Indikatoren
  isOfficial  Boolean @default(false) // Hersteller-Doku
  reportCount Int     @default(1) // wie oft gemeldet (similar issues merged)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([category])
  @@index([severity])
  @@index([status])
  @@index([sourceType])
}

// ============================================================
// Werbeplattform — buchbare Anzeigen (Banner) von Marke-Mitgliedern.
// Eine Anzeige wird an einer oder mehreren Platzierungen ausgespielt,
// solange sie aktiv ist und im Laufzeitfenster liegt. Auslieferung/Rotation
// siehe lib/ads.ts, Ausspielung via components/AdSlot.
// ============================================================
enum AdPlacement {
  HOME // Startseite (Besucher + Dashboard)
  STOREFRONT // Marken-Schaufenster (Herstellerseite)
  LISTINGS // Angebotsübersicht
}

model AdBanner {
  id             String        @id @default(cuid())
  owner          User          @relation("AdOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId        String
  // Beworbene Marke (optional) — verknüpft die Anzeige mit dem Schaufenster.
  manufacturer   Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  manufacturerId String?

  eyebrow  String? // kleine Zeile über der Schlagzeile, z.B. "DOSIMETRIX® hybrid"
  headline String // Schlagzeile
  chips    String[] @default([]) // knappe Vorteile (Pills)
  // Bild: entweder ein ausgelieferter Pfad ("/images/…") ODER eine data:-URI
  // (Upload). Die Ansicht unterscheidet anhand des Präfixes.
  image    String
  ctaLabel String   @default("Mehr erfahren")
  ctaUrl   String
  origin   String? // dezente Zusatzzeile, z.B. "Made in Switzerland"

  placements AdPlacement[] @default([])
  active     Boolean       @default(false)
  startsAt   DateTime?
  endsAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([ownerId])
}

// ---------------------------------------------------------------------------
// Tank-Register — die Pflege-Seite der Plattform (2026-08-05)
//
// Warum es das gibt: Bis hierher konnte die Seite bei der AUSWAHL eines
// Kühlschmierstoffs helfen. Der Betrieb verbringt aber Jahre mit der PFLEGE:
// wöchentlich Konzentration und pH messen, nachdosieren, irgendwann wechseln.
// Genau diese Messwerte stehen in keinem Herstellerdatenblatt — sie entstehen
// nur im Betrieb. Damit sind sie der einzige Datenschatz, den kein Wettbewerber
// abschreiben kann, und sie liefern nebenbei die Zahl, nach der alle fragen:
// die tatsächliche Standzeit im Tank.
//
// Datenschutz-Grundsatz: Messwerte gehören dem Betrieb, der sie erfasst. Sie
// sind NIE öffentlich sichtbar; nur anonymisierte Auswertungen über viele
// Betriebe hinweg dürfen später auf der Produktseite erscheinen.
// ---------------------------------------------------------------------------

/// Ein Tank (Maschine oder zentrale Anlage), dessen KSS gepflegt wird.
model CoolantTank {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Anzeigename, frei wählbar — z.B. "DMU 50 Halle 2" oder "Zentralanlage".
  name         String
  /// Maschinenbezeichnung/Hersteller, optional (z.B. "DMG Mori NHX 5000").
  machine      String?
  /// Standort/Halle, optional — hilft Betrieben mit vielen Maschinen.
  location     String?
  /// Füllmenge in Litern — Grundlage für die Nachdosier-Rechnung.
  volumeLiters Float?

  /// Welcher KSS läuft im Tank. Bevorzugt aus dem Katalog (dann greifen die
  /// Sollwerte automatisch); sonst Freitext.
  productId       String?
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productFreetext String?

  /// Ansetzwasser-Härte am Standort in °dH — bleibt über alle Messungen gleich.
  waterHardnessDh Float?

  /// Wann zuletzt frisch angesetzt wurde. Aus diesem Datum und dem Wechsel
  /// entsteht die echte Standzeit.
  filledAt DateTime?

  notes      String?
  /// Archiviert statt gelöscht — Messreihen bleiben für die Auswertung erhalten.
  archivedAt DateTime?

  /// Eindeutiger Schlüssel für den QR-Code am Tank. Wer den Aufkleber scannt,
  /// landet direkt im Messformular für GENAU diesen Tank — ohne Suchen, ohne
  /// Tippen. Der Schlüssel erlaubt nur das EINTRAGEN von Messwerten, nie das
  /// Lesen der Messreihe (die bleibt dem angemeldeten Betrieb vorbehalten).
  /// Kann neu erzeugt werden, falls ein Aufkleber in falsche Hände gerät.
  ///
  /// Bewusst OPTIONAL und bewusst OHNE `@unique`: Prisma meldet jede neue
  /// Eindeutigkeits-Regel als möglichen Datenverlust, und `prisma db push`
  /// bricht beim Deploy deshalb ab — die Seite käme nicht hoch. Der Schlüssel
  /// ist ein cuid (kollisionsfrei) und wird beim Anlegen vergeben; bestehende
  /// Tanks bekommen ihn über die Deploy-Aufgabe.
  qrToken String?

  measurements TankMeasurement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, archivedAt])
  @@index([productId])
  @@index([qrToken])
}

/// Eine Messung am Tank. Erfasst wird, was in der Werkstatt wirklich gemessen
/// wird — meist Refraktometer (Brix) und pH-Streifen.
model TankMeasurement {
  id     String      @id @default(cuid())
  tankId String
  tank   CoolantTank @relation(fields: [tankId], references: [id], onDelete: Cascade)
  /// Wer gemessen hat (für Mehrpersonen-Betriebe nachvollziehbar).
  userId String
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  measuredAt DateTime @default(now())

  /// Refraktometer-Ablesung in Brix (°Bx) — der Rohwert.
  brix             Float?
  /// Konzentration in %. Wird aus Brix × Refraktometer-Faktor des Produkts
  /// berechnet, kann aber auch direkt eingetragen werden (z.B. Titration).
  concentrationPct Float?
  ph               Float?
  temperatureC     Float?
  /// Nitrit in mg/l (ppm) — TRGS 611 begrenzt auf 20 mg/l.
  nitritePpm       Float?
  /// Keimzahl-Teststäbchen, grobe Stufe statt Laborzahl.
  bacteria         BacteriaLevel?

  /// Freitext des Prüfers: Geruch, Schaum, Verfärbung, was auffiel.
  note   String?
  /// Wie erfasst — zählt für die Auswertung, wie gut der QR-Weg angenommen wird.
  source MeasurementSource @default(WEB)

  createdAt DateTime @default(now())

  @@index([tankId, measuredAt])
  @@index([userId])
}

enum BacteriaLevel {
  NONE // nicht nachweisbar
  LOW // gering
  MEDIUM // deutlich
  HIGH // stark — Handlungsbedarf
}

enum MeasurementSource {
  WEB // am Rechner eingetragen
  QR // per QR-Code an der Maschine (Smartphone)
  VOICE // diktiert
}

/// Foto-Übergabe vom Handy an den Rechner.
///
/// Warum: Am Rechner ist „Foto aufnehmen" ein Bruch — der Nutzer müsste mit
/// dem Handy fotografieren, das Bild irgendwie auf den Rechner bringen und
/// dort hochladen. Stattdessen erzeugt der Rechner einen QR-Code, das Handy
/// scannt ihn, fotografiert, und das Bild erscheint sofort auf dem Rechner.
///
/// Der Datensatz ist eine kurzlebige Übergabe, kein Archiv: Er lebt 15 Minuten,
/// wird nach dem Abholen geleert und trägt das Bild nur in der Zwischenzeit.
/// Die ID selbst ist der Schlüssel (cuid) — wer sie hat, darf EIN Bild
/// hochladen, sonst nichts.
model PhotoHandoff {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Das Foto als data:-URI — nur zwischen Hochladen und Abholen gefüllt.
  imageData  String?
  /// Wann das Handy hochgeladen hat.
  uploadedAt DateTime?
  /// Wann der Rechner es abgeholt hat (danach wird imageData geleert).
  fetchedAt  DateTime?

  createdAt DateTime @default(now())
  /// Nach Ablauf wird nichts mehr angenommen und nichts mehr herausgegeben.
  expiresAt DateTime
  product   Product? @relation(fields: [productId], references: [id])
  productId String?

  @@index([userId, createdAt])
}

/// Vom Anbieter gemeldetes, noch nicht im Katalog stehendes Produkt.
///
/// Warum: Wer ein Angebot einstellt, wählt fast immer ein konkretes Produkt.
/// Steht es noch nicht im Katalog, soll er es melden können — aber nicht
/// ungeprüft: Datenblatt und Sicherheitsdatenblatt sind Pflicht, dazu die
/// Bestätigung, dass die Angaben stimmen und die Plattform sie verwenden darf.
/// Freigegeben wird von Hand im Admin-Bereich.
model ProductSubmission {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name         String
  manufacturer String
  productType  String
  chemistry    String?
  isoViscosity String?
  notes        String?

  /// Pflicht-Anhänge als data:-URI (PDF oder Bild) — wie bei den Angebotsfotos,
  /// weil Railway kein dauerhaftes Dateisystem hat.
  sdsFile     String
  sdsFileName String
  tdsFile     String
  tdsFileName String

  /// Der Anbieter bestätigt: Angaben korrekt UND Plattform darf die Daten
  /// verwenden. Beides ist Voraussetzung fürs Absenden.
  confirmedAccurate Boolean @default(false)
  consentToUse      Boolean @default(false)

  status    ProductSubmissionStatus @default(PENDING)
  adminNote String?
  /// Angelegtes Katalogprodukt nach Freigabe.
  productId String?

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  product    Product?  @relation(fields: [productId], references: [id])

  @@index([status, createdAt])
  @@index([userId])
}

enum ProductSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Problemfall eines Anwenders — der Kern von „Problem klären" (2026-08-12).
///
/// Betreiber: „Der User kann Fotos, Text, SDS, Datenblätter, Laborberichte,
/// Beiträge in Foren, Benutzererfahrungen etc. hochladen. Die Plattform
/// speichert die Informationen. Bei der Problemlösung soll die KI mithelfen
/// (KI darf nicht raten), das Problem zu identifizieren."
model ProblemCase {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Produkt aus dem Katalog, falls bekannt
  productId       String?
  product         Product?       @relation(fields: [productId], references: [id])
  /// Produktname als Freitext, wenn es (noch) nicht im Katalog steht
  productFreetext String?
  /// Maschine oder Anlage, an der das Problem auftritt
  machine         String?
  /// Beschreibung in eigenen Worten
  text            String
  /// Quellen im Netz (Forenbeiträge, Herstellerhinweise)
  links           String[]       @default([])
  aiVerdict       ProblemVerdict @default(NOT_CHECKED)
  aiSummary       String?
  /// Vollständige KI-Antwort als JSON — für die Anzeige und die Prüfung
  aiJson          String?
  status          ProblemStatus  @default(OFFEN)
  adminNote       String?
  createdAt       DateTime       @default(now())
  answeredAt      DateTime?
  files           ProblemFile[]

  @@index([status, createdAt])
  @@index([userId])
}

/// Beleg zu einem Problemfall: Foto, Datenblatt, Sicherheitsdatenblatt,
/// Laborbericht — alles, was bei der Einordnung hilft.
model ProblemFile {
  id        String          @id @default(cuid())
  caseId    String
  case      ProblemCase     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  kind      ProblemFileKind
  name      String
  /// data:-URI (Bild oder PDF)
  data      String
  createdAt DateTime        @default(now())

  @@index([caseId])
}

enum ProblemFileKind {
  FOTO
  DOKUMENT
}

enum ProblemVerdict {
  NOT_CHECKED
  EINGEGRENZT
  UNKLAR
}

enum ProblemStatus {
  OFFEN
  BEANTWORTET
  GESCHLOSSEN
}
